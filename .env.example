# O "cérebro" do Ultron. Precisa de UMA das duas chaves abaixo.

# Grátis: chave do Google Gemini (crie em https://aistudio.google.com/apikey, sem cartão).
GEMINI_API_KEY=

# Pago (mais inteligente): chave da Anthropic (https://console.anthropic.com/).
# Se estiver preenchida, o Ultron usa o Claude no lugar do Gemini.
ANTHROPIC_API_KEY=

# Voz: por padrão o Ultron usa as vozes neurais grátis da Microsoft (as do "Ler em voz alta" do Edge).
# Outras opções: pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural, ou "navegador".
# ULTRON_VOICE=pt-BR-AntonioNeural

# Opcional: voz ainda mais realista via ElevenLabs (https://elevenlabs.io/, tem plano grátis com limite).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Opcional
# ULTRON_USER=Otávio
# GEMINI_MODEL=gemini-flash-lite-latest
# ULTRON_MODEL=claude-opus-5-5
# PORT=3000

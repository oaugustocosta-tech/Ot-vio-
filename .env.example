# O "cérebro" do Ultron. Precisa de UMA das duas chaves abaixo.

# Grátis: chave do Google Gemini (crie em https://aistudio.google.com/apikey, sem cartão).
GEMINI_API_KEY=

# Pago (mais inteligente): chave da Anthropic (https://console.anthropic.com/).
# Se estiver preenchida, o Ultron usa o Claude no lugar do Gemini.
ANTHROPIC_API_KEY=

# Opcional: voz neural mais realista via ElevenLabs (https://elevenlabs.io/, tem plano grátis).
# Sem ela, o Ultron usa a voz do navegador (no Edge, as vozes "Natural" já são boas).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Opcional
# ULTRON_USER=Otávio
# GEMINI_MODEL=gemini-flash-latest
# ULTRON_MODEL=claude-opus-5-5
# PORT=3000

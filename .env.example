# Obrigatório: chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Opcional: voz neural grave via ElevenLabs (https://elevenlabs.io/)
# Sem ela, o Ultron usa a voz do navegador no tom mais grave possível.
ELEVENLABS_API_KEY=
# Voz a usar (padrão: "Adam", masculina e grave). Troque por qualquer voice_id da sua conta.
ELEVENLABS_VOICE_ID=

# Opcional
# ULTRON_MODEL=claude-opus-5
# PORT=3000

# O "cérebro" do Jarvis. Precisa de UMA das chaves abaixo (se houver mais de uma, vale a primeira).

# Pago (o mais inteligente): chave da Anthropic (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Grátis e muito rápido (recomendado): chave do Groq (https://console.groq.com/keys, sem cartão).
GROQ_API_KEY=

# Grátis, mais lento: chave do Google Gemini (https://aistudio.google.com/apikey, sem cartão).
GEMINI_API_KEY=

# Voz: por padrão o Jarvis usa as vozes neurais grátis da Microsoft (as do "Ler em voz alta" do Edge).
# Outras opções: pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural, ou "navegador".
# JARVIS_VOICE=pt-BR-AntonioNeural

# Opcional: voz mais realista via ElevenLabs (https://elevenlabs.io/). O plano grátis dá ~20 min
# de fala por mês; quando acabar, o Jarvis volta sozinho para a voz da Microsoft.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Opcional
# JARVIS_USER=Otávio
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest
# JARVIS_MODEL=claude-opus-5-5
# PORT=3000
